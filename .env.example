# Copy this file to .env.local and fill in the values.
# Never commit .env.local. The anon key is public. Do not put the service_role key in this app.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API → anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where this app runs. Google and email links send people back here.
# Local: http://localhost:3000
# On Vercel, use your real site address, including https://
NEXT_PUBLIC_SITE_URL=http://localhost:3000
